#!/usr/bin/env ruby
# frozen_string_literal: true

# WAL checkpoints off the request path, as the Rust port runs them: the app's connections turn
# SQLite's auto-checkpoint off (it ran inside whichever commit crossed 1,000 WAL pages, fsyncing
# while that process held the write lock), and this process copies the WAL back into the database
# with PASSIVE checkpoints, which never block writers. If the WAL still grows past 10,000 pages, a
# RESTART checkpoint waits for the writers and rewinds it.
require "sqlite3"
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "campfire/db"

INTERVAL = 0.05
RESTART_PAGES = 10_000

db = SQLite3::Database.new(Campfire::DB.path)
db.busy_timeout = Campfire::DB::BUSY_TIMEOUT_MS
db.execute("PRAGMA journal_size_limit = 67108864")

loop do
  sleep INTERVAL
  _busy, frames, _done = db.execute("PRAGMA wal_checkpoint(PASSIVE)").first
  db.execute("PRAGMA wal_checkpoint(RESTART)") if frames.to_i > RESTART_PAGES
rescue SQLite3::Exception => error
  warn "checkpoint: #{error.class}: #{error.message}"
end
